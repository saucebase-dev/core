{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "saucebase/core",
    "description": "The Saucebase core package — navigation, localization, module infrastructure, the settings modal, and the Inertia layer.",
    "keywords": [
        "laravel",
        "saucebase",
        "saas"
    ],
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Saucebase",
            "email": "hello@saucebase.dev"
        },
        {
            "name": "Renan Roble",
            "email": "renanroble@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.5",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.34"
    },
    "autoload": {
        "psr-4": {
            "Saucebase\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saucebase\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saucebase\\Core\\CoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
