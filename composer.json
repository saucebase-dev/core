{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "saucebase/core",
  "description": "The AI-ready Laravel SaaS kit: billing, workspaces, blog and admin as modules, each with Laravel Boost guidelines and skills for your agent.",
  "keywords": [
    "laravel",
    "saucebase",
    "saas"
  ],
  "version": "v2.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Saucebase",
      "email": "hello@saucebase.dev"
    },
    {
      "name": "Renan Roble",
      "email": "renanroble@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "cviebrock/eloquent-sluggable": "^13.0.2",
    "filament/filament": "^5.10.3",
    "filament/spatie-laravel-media-library-plugin": "^5.10.3",
    "filament/spatie-laravel-settings-plugin": "^5.10.3",
    "inertiajs/inertia-laravel": "^3.5.2",
    "inertiaui/modal": "^3.1.2",
    "internachi/modular": "^3.0.2",
    "laravel/boost": "^2.10.3",
    "laravel/framework": "^13.38",
    "saucebase/breadcrumbs": "^1.1",
    "saucebase/module-installer": "^3.0.1",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-navigation": "^1.3",
    "spatie/laravel-permission": "^8.3.2",
    "spatie/laravel-settings": "^3.10",
    "spatie/laravel-sitemap": "^8.2",
    "spatie/laravel-typescript-transformer": "^3.3",
    "symfony/filesystem": "^8.1.9",
    "tightenco/ziggy": "^2.6.5"
  },
  "require-dev": {
    "larastan/larastan": "^3.13.1",
    "laravel/pint": "^1.32.1",
    "orchestra/testbench": "^11.3",
    "phpunit/phpunit": "^13.4.3"
  },
  "autoload": {
    "psr-4": {
      "Saucebase\\Core\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Saucebase\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Saucebase\\Core\\CoreServiceProvider"
      ],
      "dont-discover": [
        "internachi/modular"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "saucebase/module-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "pint",
    "lint:test": "pint --test",
    "analyse": "phpstan analyse --memory-limit=2G",
    "types": "UPDATE_TYPES=1 phpunit --filter GeneratedTypesTest"
  },
  "scripts-descriptions": {
    "test": "Run the test suite",
    "lint": "Fix code style with Pint",
    "lint:test": "Check code style without changing files",
    "analyse": "Run static analysis",
    "types": "Regenerate resources/js/types/generated.d.ts from the PHP classes"
  }
}
