{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "name": "saucebase",
    "description": "A complete saas boilerplace powered with Vue, Filament, InertiaJS, and more",
    "type": "module",
    "workspaces": [
        "modules/*"
    ],
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "preview": "vite preview",
        "host": "vite --host",
        "format": "prettier --write vendor/saucebase/core/stubs/stack/vue/js resources/css modules/**/resources/",
        "format:check": "prettier --check vendor/saucebase/core/stubs/stack/vue/js resources/css modules/**/resources/",
        "test": "playwright test",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "screenshots": "npm run build && tsx scripts/capture-screenshots.ts",
        "lint": "eslint ./vendor/saucebase/core/stubs/stack/vue/js ./modules/*/resources --fix --no-error-on-unmatched-pattern"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@go-task/cli": "^3.54.0",
        "@iconify-json/circle-flags": "^1.2.12",
        "@iconify-json/fluent": "^1.2.60",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.147",
        "@iconify-json/simple-icons": "^1.2.100",
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@playwright/test": "^1.64.1",
        "@saucebase/laravel-playwright": "^2.0.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.6",
        "dotenv": "^18.0.9",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "laravel-vite-plugin": "^3.2.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn-vue": "^2.8.2",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/outfit": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.1",
        "@inertiaui/modal-vue": "^3.1.2",
        "@lucide/vue": "^1.61.0",
        "@vue/server-renderer": "^3.5.44",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vue-i18n": "^2.9.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "vue-sonner": "^2.0.9"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.5.1"
    },
    "lint-staged": {
        "**/*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "!(*.{js,ts,vue})": "prettier --write --ignore-unknown"
    }
}
