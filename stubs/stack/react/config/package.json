{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "name": "saucebase",
    "description": "A complete saas boilerplate powered with React, Filament, InertiaJS, and more",
    "type": "module",
    "workspaces": [
        "modules/*"
    ],
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "preview": "vite preview",
        "host": "vite --host",
        "format": "prettier --write vendor/saucebase/core/stubs/stack/react/js resources/css modules/**/resources/",
        "format:check": "prettier --check vendor/saucebase/core/stubs/stack/react/js resources/css modules/**/resources/",
        "test": "playwright test",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "screenshots": "npm run build && tsx scripts/capture-screenshots.ts",
        "lint": "eslint ./vendor/saucebase/core/stubs/stack/react/js ./modules/*/resources --fix --no-error-on-unmatched-pattern"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@go-task/cli": "^3.54.0",
        "@iconify-json/circle-flags": "^1.2.12",
        "@iconify-json/fluent": "^1.2.60",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.147",
        "@iconify-json/simple-icons": "^1.2.100",
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@playwright/test": "^1.64.1",
        "@saucebase/laravel-playwright": "^2.0.1",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "dotenv": "^18.0.9",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "lint-staged": "^17.6.0",
        "lucide-react": "^1.61.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn": "^4.22.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/outfit": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.1",
        "@inertiaui/modal-react": "^3.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.5.1"
    },
    "lint-staged": {
        "**/*.{js,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "!(*.{js,ts,tsx})": "prettier --write --ignore-unknown"
    },
    "version": "0.0.0",
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
